# 票证检测矫正服务 - GPU 镜像
# 构建:   docker build -f Dockerfile.gpu -t card-correction:gpu .
# 运行(需宿主机安装 nvidia-container-toolkit):
#         docker run --rm --gpus all -p 8300:8300 -v $(pwd)/saved:/app/saved -e DEVICE=gpu card-correction:gpu
FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

# opencv(headless) 运行时依赖
RUN apt-get update \
    && apt-get install -y --no-install-recommends libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 基础镜像已含 CUDA 版 torch 2.6.0, 满足 requirements 的 torch>=2.6, 不会被重装
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 应用代码 + 模型权重(约124MB)
COPY app.py test_service.py service_config.json README.md ./
COPY pytorch_model.pt configuration.json ./
COPY data ./data

# DEVICE=gpu; 若容器内 CUDA 不可用, app.py 会自动回退 CPU 并打日志
ENV DEVICE=gpu \
    PORT=8300 \
    MODELSCOPE_CACHE=/tmp/modelscope \
    PYTHONUNBUFFERED=1

EXPOSE 8300

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8300/health', timeout=3).status==200 else 1)"

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8300", "--workers", "1"]
